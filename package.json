{
	"name": "spendtip-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "CLOUDFLARE_ENV= react-router build",
		"build:stg": "CLOUDFLARE_ENV=stg react-router build",
		"build:prod": "CLOUDFLARE_ENV=prod react-router build",
		"dev": "CLOUDFLARE_ENV= react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b && tsc -p tsconfig.test.json",
		"check:types": "bun run typecheck",
		"check:quality": "biome check .",
		"check:quality:fix": "biome check . --write --unsafe",
		"test": "bun test app",
		"deploy": "echo 'Choose bun run deploy:stg or bun run deploy:prod' && exit 1",
		"deploy:stg": "bun run build:stg && wrangler deploy --env stg",
		"deploy:prod": "bun run build:prod && wrangler deploy --env prod",
		"db:init:local": "wrangler d1 execute DB --config wrangler.jsonc --env= --local --command 'SELECT 1'",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --env= --local",
		"db:migrate:stg": "wrangler d1 migrations apply DB --config wrangler.jsonc --env stg --remote",
		"db:migrate:prod": "wrangler d1 migrations apply DB --config wrangler.jsonc --env prod --remote",
		"db:studio:local": "tsx scripts/db-studio.ts local",
		"db:studio:stg": "tsx scripts/db-studio.ts stg",
		"db:studio:prod": "tsx scripts/db-studio.ts prod",
		"preview": "bun run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@clerk/react-router": "^3.6.29",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"effect": "^4.0.0-rc.117",
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.4.0",
		"resend": "^6.28.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/vite-plugin": "^1.56.0",
		"@libsql/client": "^0.18.0",
		"@react-router/dev": "^8.3.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^26.6.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"drizzle-kit": "^1.0.0-rc.4",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "^4.135.0"
	}
}
